APP_NAME="Dot.Pulse"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://pulse.infodot.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=infodot
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@infodot.co.za"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Leave the key empty and every new post waits for a human moderator.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT=10

# New posts are checked by a queue worker (php artisan queue:work).
# PULSE_EDIT_WINDOW_MINUTES=30
# PULSE_LIMIT_POST=20
# PULSE_LIMIT_COMMENT=30
# PULSE_LIMIT_REACT=60
# PULSE_LIMIT_REPORT=10
# PULSE_LIMIT_JOIN_REQUEST=10
# PULSE_JOIN_REQUEST_COOLDOWN_DAYS=7

# InfoDot sign-in (signed redeem). This app has its own database, so InfoDot's
# one-time handoff token is proved by calling InfoDot rather than looked up here.
# INFODOT_SERVICE_SECRET must equal ECOSYSTEM_SECRET_PULSE in InfoDot's .env, and
# InfoDot must have this platform marked live. Blank = local-token behaviour only.
INFODOT_REDEEM_URL=https://infodot.co.za/api/ecosystem/redeem
INFODOT_PLATFORM_KEY=pulse
INFODOT_SERVICE_SECRET=
INFODOT_REDEEM_TIMEOUT=5
INFODOT_PROVISION_USERS=true

# Dot.Analytics daily snapshot (aggregate counts only, queued, never affects this app).
# Nothing is sent until ALL THREE of the url, the secret and the company uuid are set.
# URL is the full ingest URL ending /api/ingest/snapshots; the secret equals ANALYTICS_INGEST_SECRET_PULSE
# in Dot.Analytics. Pulse is one global network, so the numbers describe the platform and are filed under
# the operator's own InfoDot company uuid.
ANALYTICS_INGEST_URL=
ANALYTICS_INGEST_SECRET=
ANALYTICS_PLATFORM_KEY=pulse
ANALYTICS_COMPANY_UUID=

# Public sign-up is closed; InfoDot creates accounts at first sign-in. Set true only for a deliberate window.
ALLOW_REGISTRATION=false
